generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUCTIONEER
  BIDDER
}

enum LotStatus {
  SCHEDULED
  LIVE
  CLOSED
  CANCELLED
}

enum LedgerEntryKind {
  DEPOSIT
  COMMIT
  RELEASE
  SETTLEMENT_DEBIT
  SETTLEMENT_CREDIT
}

enum LotCategory {
  FINE_ART
  JEWELRY
  WATCHES
  ANTIQUITIES
  NUMISMATICS
  FASHION
  VEHICLES
  BOOKS
  WINE
  OTHER
}

enum CatalogProvider {
  ART_INSTITUTE_CHICAGO
  SCRYFALL
  OPEN_LIBRARY
}

// Better Auth tables
model User {
  id               String   @id @default(cuid())
  role             Role
  email            String   @unique
  name             String
  emailVerified    Boolean  @default(false)
  encryptedEmail   String
  encryptedFullName String
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  passkeys  Passkey[]
  wallet    Wallet?
  lots      Lot[]     @relation("AuctioneerLots")
  bids      Bid[]
  receipts  Receipt[] @relation("WinnerReceipts")
  auctioneeredReceipts Receipt[] @relation("AuctioneerReceipts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Passkey {
  id                   String   @id @default(cuid())
  userId               String
  name                 String?
  publicKey            String
  credentialId         String   @unique
  counter              BigInt
  deviceType           String
  backedUp             Boolean
  transports           String?
  aaguid               String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalCents      BigInt   @default(0)
  committedCents  BigInt   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger  WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id          String          @id @default(cuid())
  walletId    String
  kind        LedgerEntryKind
  amountCents BigInt
  lotId       String?
  bidId       String?
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model CatalogItemSnapshot {
  id             String          @id @default(cuid())
  provider       CatalogProvider
  externalId     String
  title          String
  attributes     Json
  sourceImageUrl String?
  storedImageKey String?
  fetchedAt      DateTime        @default(now())

  lots Lot[]

  @@unique([provider, externalId])
}

model Lot {
  id                 String      @id @default(cuid())
  auctioneerId       String
  snapshotId         String
  title              String
  description        String?
  additionalImages   String[]
  category           CatalogProvider
  lotCategory        LotCategory     @default(OTHER)
  startingBidCents   BigInt
  minIncrementCents  BigInt
  startsAt           DateTime
  originalEndsAt     DateTime
  endsAt             DateTime
  status             LotStatus   @default(SCHEDULED)
  currentBidCents    BigInt?
  leadingBidderId    String?
  bidCount           Int         @default(0)
  chainHeadHash      String?
  chainHeadSignature String?
  closedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime    @default(now())

  auctioneer User                @relation("AuctioneerLots", fields: [auctioneerId], references: [id])
  snapshot   CatalogItemSnapshot @relation(fields: [snapshotId], references: [id])
  bids       Bid[]
  extensions LotExtension[]
  receipt    Receipt?

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([auctioneerId, status])
  @@index([category, status])
  @@index([lotCategory, status])
}

model Bid {
  id           String   @id @default(cuid())
  lotId        String
  bidderId     String
  sequence     Int
  amountCents  BigInt
  placedAt     DateTime @default(now())
  previousHash String
  hash         String
  signature    String

  lot      Lot   @relation(fields: [lotId], references: [id])
  bidder   User  @relation(fields: [bidderId], references: [id])
  extension LotExtension?

  @@unique([lotId, sequence])
  @@index([bidderId, placedAt])
}

model LotExtension {
  id              String   @id @default(cuid())
  lotId           String
  bidId           String   @unique
  previousEndsAt  DateTime
  newEndsAt       DateTime
  createdAt       DateTime @default(now())

  lot Lot @relation(fields: [lotId], references: [id])
  bid Bid @relation(fields: [bidId], references: [id])
}

model Receipt {
  id              String   @id @default(cuid())
  lotId           String   @unique
  winnerId        String
  auctioneerId    String
  amountCents     BigInt
  finalChainHash  String
  publicToken     String   @unique
  signature       String
  issuedAt        DateTime @default(now())

  lot        Lot  @relation(fields: [lotId], references: [id])
  winner     User @relation("WinnerReceipts", fields: [winnerId], references: [id])
  auctioneer User @relation("AuctioneerReceipts", fields: [auctioneerId], references: [id])

  @@index([winnerId])
}
