# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://auction:auction@localhost:5432/auction_house

# Redis
REDIS_URL=redis://localhost:6379

# Fernet keys for PII encryption (comma-separated, first key used for new encryptions)
# Generate: bun run scripts/generate-keys.ts
FERNET_KEYS=base64-encoded-32-byte-key1,base64-encoded-32-byte-key2

# Email blind-index HMAC key (min 32 chars)
EMAIL_LOOKUP_KEY=change-me-email-lookup-key-min-32-chars

# Bidder pseudonym derivation key (min 32 chars)
PSEUDONYM_KEY=change-me-pseudonym-key-min-32-chars-here

# Audit hash signing key (min 32 chars)
AUDIT_SIGNING_KEY=change-me-audit-signing-key-min-32-chars

# Better Auth
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Passkeys (WebAuthn)
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# CORS
FRONTEND_ORIGIN=http://localhost:5173
